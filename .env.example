# Copy this file to .env.local, then fill BOTH required values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: only needed for AI-assisted review, not login or reports.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
