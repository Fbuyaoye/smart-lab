# Copy this file to .env.local, then fill BOTH required values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred: teacher-review-toolkit proxy to the shared AI service.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
# Preferred: teacher-review-toolkit's OpenAI-compatible inference service.
TEACHER_REVIEW_API_URL=
TEACHER_REVIEW_API_KEY=
TEACHER_REVIEW_MODEL=
# Compatibility fallback when the toolkit is not configured.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
