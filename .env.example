PORT=8787
HOST=0.0.0.0
INTERNAL_API_TOKEN=replace-with-a-long-random-value
# glm calls Zhipu AI from this server; the browser never sees GLM_API_KEY.
AI_MODE=glm
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_TIMEOUT_MS=30000
# ALLOWED_ORIGIN=https://your-student-site.example
KNOWLEDGE_BASE_INDEX_PATH=../smart-lab-knowledge-base/index.json
# Optional modes: local uses the trained local classifier; deepseek uses DeepSeek.
LOCAL_AI_MODEL_PATH=models/intent-model.json
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_MS=30000
